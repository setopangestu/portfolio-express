<!DOCTYPE html>
<html>
<head>
    <title><%= title %> — Work Experience</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
    <canvas id="particle-canvas"></canvas>
    <div class="floating-tech">
        <div class="tech-bubble">Work</div>
        <div class="tech-bubble">Growth</div>
        <div class="tech-bubble">Learning</div>
        <div class="tech-bubble">Experience</div>
    </div>

    <nav class="navbar">
        <div class="container">
            <div class="logo">Seto<span>Aji</span></div>
            <div class="menu-toggle"><i class="fas fa-bars"></i></div>
            <div class="nav-links">
                <a href="/">Home</a>
                <a href="/about">About</a>
                <a href="/skills">Skills</a>
                <a href="/experiences" class="active">Experience</a>
                <a href="/educations">Education</a>
            </div>
        </div>
    </nav>

    <main>
        <div class="container">
            <div class="section-header">
                <span class="eyebrow"><i class="fas fa-briefcase"></i> PERJALANAN KARIR</span>
                <h2>Pengalaman Profesional</h2>
                <p>Perjalanan saya dalam mengasah skill dan berkontribusi di dunia industri teknologi</p>
            </div>

            <div class="experience-highlight">
                <h3><i class="fas fa-star-of-life"></i> Sorotan: Praktik Kerja Lapangan (PKL)</h3>
                <p>Pengalaman paling berharga yang membentuk cara saya berpikir sebagai seorang developer.</p>
                <ul>
                    <li><i class="fas fa-building"></i> <strong>PT Patra Energy Swadaya Engineering</strong> – Bergabung sebagai Junior Web Developer trainee.</li>
                    <li><i class="fas fa-code"></i> Mengembangkan dan memelihara aplikasi internal perusahaan dengan <strong>Laravel & MySQL</strong>.</li>
                    <li><i class="fas fa-users"></i> Berkontribusi langsung dalam pembuatan <strong>sistem absensi karyawan</strong> dan modul pengelolaan data.</li>
                    <li><i class="fas fa-users-cog"></i> Terbiasa bekerja dalam tim, mengikuti alur kerja Agile, dan melakukan debugging & fixing bug.</li>
                </ul>
                <p class="highlight-note"><i class="fas fa-gem"></i> Pengalaman ini melatih saya untuk bekerja di bawah tekanan, memenuhi kebutuhan user (client), dan memahami pentingnya kode yang maintainable.</p>
            </div>

            <div class="timeline">
                <h3 class="timeline-title"><i class="fas fa-history"></i> Riwayat Pekerjaan & Proyek</h3>
                <% if (experiences.length > 0) { %>
                    <% experiences.forEach(exp => { %>
                        <div class="timeline-item">
                            <h3><%= exp.position %></h3>
                            <h4><%= exp.company %></h4>
                            <div class="timeline-date"><i class="far fa-calendar-alt"></i> <%= exp.start_date %> — <%= exp.currently_working ? 'Sekarang' : exp.end_date %></div>
                            <p><%= exp.description %></p>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p style="text-align: center;">Belum ada data pengalaman yang dimasukkan admin.</p>
                <% } %>
            </div>
        </div>
    </main>

    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-info">
                    <div class="footer-logo">Seto<span>Aji</span></div>
                    <p>Junior Web Developer passionate about building digital solutions.</p>
                </div>
                <div class="footer-links">
                    <h4>Quick Links</h4>
                    <a href="/">Home</a><a href="/about">About</a><a href="/skills">Skills</a><a href="/experiences">Experience</a><a href="/educations">Education</a>
                </div>
                <div class="footer-contact">
                    <h4>Connect</h4>
                    <div class="social-icons">
                        <a href="https://github.com/setopangestu" target="_blank"><i class="fab fa-github"></i></a>
                        <a href="https://www.linkedin.com/in/seto-aji-pangestu-78a297403/" target="_blank"><i class="fab fa-linkedin-in"></i></a>
                        <a href="mailto:seto@example.com"><i class="fas fa-envelope"></i></a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom"><p>&copy; 2026 Seto Aji Pangestu | Built with Express.js + Supabase</p></div>
        </div>
    </footer>

    <script src="/script.js"></script>
    <style>
        .experience-highlight {
            background: linear-gradient(135deg, var(--primary-light), #FFF0E8);
            border-radius: 24px;
            padding: 32px;
            margin-bottom: 50px;
        }
        .experience-highlight h3 {
            color: var(--primary);
            margin-bottom: 16px;
        }
        .experience-highlight h3 i {
            margin-right: 10px;
        }
        .experience-highlight ul {
            margin-left: 24px;
            margin-top: 16px;
            margin-bottom: 16px;
            line-height: 1.8;
            color: var(--gray-dark);
            list-style: none;
        }
        .experience-highlight ul li {
            margin-bottom: 10px;
        }
        .experience-highlight ul li i {
            width: 25px;
            color: var(--primary);
        }
        .highlight-note {
            font-style: italic;
            color: var(--gray);
            border-left: 3px solid var(--primary);
            padding-left: 16px;
            margin-top: 16px;
        }
        .timeline-title {
            text-align: center;
            margin-bottom: 30px;
            font-size: 1.6rem;
        }
        .timeline-title i {
            color: var(--primary);
            margin-right: 10px;
        }
        .timeline-date i {
            margin-right: 6px;
        }
    </style>
</body>
</html>