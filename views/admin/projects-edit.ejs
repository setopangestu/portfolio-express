<!DOCTYPE html>
<html>
<head>
    <title>Edit Project</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>✏️ Edit Project</h1>
    
    <div class="admin-menu">
        <a href="/admin">📋 Projects</a>
        <a href="/admin/skills">⚡ Skills</a>
        <a href="/admin/experiences">💼 Experiences</a>
        <a href="/admin/educations">🎓 Educations</a>
        <a href="/">👁️ Lihat Portfolio</a>
        <a href="/logout">🚪 Logout</a>
    </div>
    
    <form method="POST" action="/admin/projects-edit/<%= project.id %>" enctype="multipart/form-data">
        <div>
            <label>Judul Project:</label><br>
            <input type="text" name="title" value="<%= project.title %>" required style="width: 100%; padding: 8px;">
        </div>
        
        <div>
            <label>Deskripsi:</label><br>
            <textarea name="description" rows="5" required style="width: 100%; padding: 8px;"><%= project.description %></textarea>
        </div>
        
        <div>
            <label>Tech Stack (pisahkan dengan koma):</label><br>
            <input type="text" name="tech_stack" value="<%= project.tech_stack ? project.tech_stack.join(', ') : '' %>" style="width: 100%; padding: 8px;">
            <small>Contoh: HTML, CSS, JavaScript, Node.js</small>
        </div>
        
        <div>
            <label>GitHub URL:</label><br>
            <input type="text" name="github_url" value="<%= project.github_url || '' %>" placeholder="https://github.com/username/repo" style="width: 100%; padding: 8px;">
        </div>
        
        <div>
            <label>Live URL:</label><br>
            <input type="text" name="live_url" value="<%= project.live_url || '' %>" placeholder="https://example.com" style="width: 100%; padding: 8px;">
        </div>

            <label>Gambar Project Saat Ini:</label><br>
            <% if (project.image_url) { %>
                <img src="<%= project.image_url %>" alt="<%= project.title %>" style="max-width: 200px; margin: 10px 0; border-radius: 8px;">
                <br>
                <a href="/admin/projects-remove-image/<%= project.id %>" 
                   onclick="return confirm('Yakin hapus gambar ini?')" 
                   style="color: red; font-size: 14px;">🗑️ Hapus Gambar</a>
            <% } else { %>
                <p>Belum ada gambar</p>
            <% } %>
            <br>
            <label>Upload Gambar Baru (opsional):</label><br>
            <input type="file" name="image" accept="image/*">
        </div>
        
        <br>
        <button type="submit" style="background: #28a745; color: white; padding: 10px 20px; border: none; border-radius: 5px; cursor: pointer;">💾 Update Project</button>
        <a href="/admin" style="margin-left: 10px;">Batal</a>
    </form>
</body>
</html>