<!DOCTYPE html>
<html>
<head>
    <title>Tambah Pengalaman</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Tambah Pengalaman Baru</h1>
    
    <form method="POST" action="/admin/experiences-add">
        <div>
            <label>Posisi:</label><br>
            <input type="text" name="position" placeholder="Contoh: Junior Web Developer" required>
        </div>
        
        <div>
            <label>Perusahaan:</label><br>
            <input type="text" name="company" placeholder="Contoh: PT Patra Energy" required>
        </div>
        
        <div>
            <label>Lokasi:</label><br>
            <input type="text" name="location" placeholder="Contoh: Jakarta">
        </div>
        
        <div>
            <label>Tanggal Mulai:</label><br>
            <input type="text" name="start_date" placeholder="Contoh: 2024" required>
        </div>
        
        <div>
            <label>Tanggal Selesai:</label><br>
            <input type="text" name="end_date" placeholder="Kosongkan jika masih bekerja">
        </div>
        
        <div>
            <label>Masih Bekerja Disini:</label><br>
            <input type="checkbox" name="currently_working">
        </div>
        
        <div>
            <label>Deskripsi:</label><br>
            <textarea name="description" rows="5" placeholder="Ceritakan tanggung jawab dan pencapaianmu..."></textarea>
        </div>
        
        <button type="submit">Simpan</button>
        <a href="/admin/experiences">Batal</a>
    </form>
</body>
</html>