<!DOCTYPE html>
<html>
<head>
    <title>Manage Educations</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>🎓 Manage Pendidikan</h1>
    
    <div class="admin-menu">
        <a href="/admin">📋 Projects</a>
        <a href="/admin/skills">⚡ Skills</a>
        <a href="/admin/experiences">💼 Experiences</a>
        <a href="/admin/educations">🎓 Educations</a>
        <a href="/">👁️ Lihat Portfolio</a>
        <a href="/logout">🚪 Logout</a>
    </div>
    
    <h2>Daftar Pendidikan</h2>
    
    <a href="/admin/educations-add">+ Tambah Pendidikan</a>
    
    <% if (educations && educations.length > 0) { %>
        <% educations.forEach(edu => { %>
            <div style="background:white; padding:15px; margin:10px 0; border-radius:5px;">
                <h3><%= edu.degree %></h3>
                <p><strong><%= edu.institution %></strong></p>
                <p>Tahun: <%= edu.year %></p>
                <p><%= edu.description %></p>
                <a href="/admin/educations-edit/<%= edu.id %>">✏️ Edit</a> |
                <a href="/admin/educations-delete/<%= edu.id %>" onclick="return confirm('Yakin hapus?')" style="color:red;">🗑️ Hapus</a>
            </div>
        <% }); %>
    <% } else { %>
        <p>Belum ada pendidikan.</p>
    <% } %>
</body>
</html>