<!DOCTYPE html>
<html>
<head>
    <title>Tambah Skill</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Tambah Skill Baru</h1>
    
    <form method="POST" action="/admin/skills-add">
        <div>
            <label>Nama Skill:</label><br>
            <input type="text" name="name" placeholder="Contoh: JavaScript" required>
        </div>
        
        <div>
            <label>Level:</label><br>
            <select name="level">
                <option value="Beginner">Beginner</option>
                <option value="Intermediate">Intermediate</option>
                <option value="Advanced">Advanced</option>
                <option value="Expert">Expert</option>
            </select>
        </div>
        
        <div>
            <label>Icon (opsional):</label><br>
            <input type="text" name="icon" placeholder="Contoh: javascript">
        </div>
        
        <button type="submit">Simpan</button>
        <a href="/admin/skills">Batal</a>
    </form>
</body>
</html>