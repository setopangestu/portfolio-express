<!DOCTYPE html>
<html>
<head>
    <title>Edit Education</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>✏️ Edit Pendidikan</h1>
    
    <div class="admin-menu">
        <a href="/admin">📋 Projects</a>
        <a href="/admin/skills">⚡ Skills</a>
        <a href="/admin/experiences">💼 Experiences</a>
        <a href="/admin/educations">🎓 Educations</a>
        <a href="/">👁️ Lihat Portfolio</a>
        <a href="/logout">🚪 Logout</a>
    </div>
    
    <form method="POST" action="/admin/educations-edit/<%= education.id %>">
        <div>
            <label>Jenjang / Gelar:</label><br>
            <input type="text" name="degree" value="<%= education.degree %>" required>
        </div>
        
        <div>
            <label>Nama Institusi:</label><br>
            <input type="text" name="institution" value="<%= education.institution %>" required>
        </div>
        
        <div>
            <label>Tahun:</label><br>
            <input type="text" name="year" value="<%= education.year %>" required>
        </div>
        
        <div>
            <label>Deskripsi:</label><br>
            <textarea name="description" rows="5"><%= education.description || '' %></textarea>
        </div>
        
        <button type="submit">💾 Update Education</button>
        <a href="/admin/educations">Batal</a>
    </form>
</body>
</html>